[flake8]
max-line-length = 120
exclude =
    venv,
    .venv,
    __pycache__,
    .git,
    node_modules,
    frontend,
    .stryker-tmp,
    migrations,
    *.egg-info,
    dist,
    build,
    .pytest_cache,
    .coverage
per-file-ignores =
    # Permitir importaciones sin usar en __init__.py
    __init__.py: F401
