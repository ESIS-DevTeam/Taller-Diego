      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sli:availability:ratio_5m", "legendFormat": "SLI disponibilidad" }
      ]
