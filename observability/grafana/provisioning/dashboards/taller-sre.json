      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "expr": "clamp_min(slo:error_budget_consumed:ratio, 0)", "legendFormat": "budget consumido" }
      ]
    },
    {
      "id": 8,
