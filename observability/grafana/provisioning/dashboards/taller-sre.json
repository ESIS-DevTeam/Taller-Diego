{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "title": "Taller de Diego · SRE — SLIs / SLOs / Error Budget",
  "tags": ["sre", "slo", "taller-diego"],
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fase 1 · Estado del servicio  up{job=\"taller-diego-backend\"}",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CAÍDO", "color": "red" } } },
            { "type": "value", "options": { "1": { "text": "ARRIBA", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "red" },
            { "value": 1, "color": "green" }
          ] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none", "textMode": "value_and_name" },
      "targets": [
        { "refId": "A", "expr": "up{job=\"taller-diego-backend\"}", "legendFormat": "backend" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "SLI Availability (5m)",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "red" },
            { "value": 0.99, "color": "green" }
          ] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value" },
      "targets": [
        { "refId": "A", "expr": "sli:availability:ratio_5m", "legendFormat": "disponibilidad" }
      ]
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "Fase 4 · Error Budget consumido",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 1,
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 0.5, "color": "orange" },
            { "value": 1, "color": "red" }
          ] }
        }
      },
      "options": { "showThresholdLabels": true, "showThresholdMarkers": true },
      "targets": [
        { "refId": "A", "expr": "clamp_min(slo:error_budget_consumed:ratio, 0)", "legendFormat": "budget consumido" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Latency p99 (5m)",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [
            { "value": null, "color": "green" },
            { "value": 1, "color": "red" }
          ] }
        }
      },
      "options": { "colorMode": "background", "graphMode": "area", "textMode": "value" },
      "targets": [
        { "refId": "A", "expr": "sli:latency_p99:seconds_5m", "legendFormat": "p99" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Fase 3 · SLI Availability vs SLO (línea 0.99)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
