      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "expr": "sli:latency_p99:seconds_5m", "legendFormat": "p99 latencia" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Fase 4 · Error Budget consumido en el tiempo (zona roja > 100%)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
